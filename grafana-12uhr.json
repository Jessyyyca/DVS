      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "dg0onq06grchsf"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    pokemon_name,\r\n    (\r\n        100.0 * SUM(COALESCE(decks_using_pokemon, 0))\r\n        / NULLIF(SUM(total_decks), 0)\r\n    )::double precision AS usage_rate,\r\n    (\r\n        100.0 * SUM(COALESCE(wins, 0))\r\n        / NULLIF(\r\n            SUM(\r\n                COALESCE(wins, 0)\r\n                + COALESCE(losses, 0)\r\n                + COALESCE(ties, 0)\r\n            ), 0\r\n        )\r\n    )::double precision AS win_rate\r\nFROM reporting.v_pokemon_competitive_metrics\r\nWHERE\r\n    $__timeFilter(full_date)\r\n    AND pokemon_key IN (${pokemon:csv})\r\n    AND (\r\n        type_one IN (${pokemon_type:sqlstring})\r\n        OR type_two IN (${pokemon_type:sqlstring})\r\n    )\r\n    AND base_stat_total BETWEEN\r\n        CAST('${min_bst}' AS integer)\r\n        AND CAST('${max_bst}' AS integer)\r\nGROUP BY pokemon_key, pokemon_name\r\nORDER BY pokemon_name;",
                        "sql": {
