      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "dg0onq06grchsf"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH aggregated AS (\r\n    SELECT\r\n        pokemon_key,\r\n        pokemon_name,\r\n        DATE_TRUNC(\r\n            '${granularity:raw}',\r\n            full_date\r\n        )::date AS period,\r\n        100.0 * SUM(COALESCE(wins, 0))\r\n            / NULLIF(\r\n                SUM(\r\n                    COALESCE(wins, 0)\r\n                    + COALESCE(losses, 0)\r\n                    + COALESCE(ties, 0)\r\n                ), 0\r\n            ) AS win_rate,\r\n        100.0 * SUM(COALESCE(decks_using_pokemon, 0))\r\n            / NULLIF(SUM(total_decks), 0)\r\n            AS usage_rate\r\n    FROM reporting.v_pokemon_competitive_metrics\r\n    WHERE\r\n        $__timeFilter(full_date)\r\n        AND pokemon_key IN (${pokemon:csv})\r\n        AND (\r\n            type_one IN (${pokemon_type:sqlstring})\r\n            OR type_two IN (${pokemon_type:sqlstring})\r\n        )\r\n        AND base_stat_total BETWEEN\r\n            CAST('${min_bst}' AS integer)\r\n            AND CAST('${max_bst}' AS integer)\r\n    GROUP BY\r\n        pokemon_key,\r\n        pokemon_name,\r\n        period\r\n)\r\nSELECT\r\n    CASE '${orientation:raw}'\r\n        WHEN 'date_rows' THEN period::text\r\n        ELSE pokemon_name\r\n    END AS row_dimension,\r\n    CASE '${orientation:raw}'\r\n        WHEN 'date_rows' THEN pokemon_name\r\n        ELSE period::text\r\n    END AS column_dimension,\r\n    ROUND(\r\n        CASE '${drill_across_metric:raw}'\r\n            WHEN 'usage_rate' THEN usage_rate\r\n            ELSE win_rate\r\n        END, 2\r\n    )::double precision AS metric_value\r\nFROM aggregated\r\nORDER BY 1, 2;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
